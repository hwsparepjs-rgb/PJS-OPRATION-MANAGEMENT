{
  "name": "oms-independent",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:pick-slip && npm run test:done-pick && npm run test:migration && npm run test:business && npm run test:lr && npm run test:excel && npm run test:document-fields && npm run test:done-pick-albums && npm run test:document-merge && npm run test:agent && vite build",
    "preview": "vite preview",
    "test:done-pick": "node --experimental-strip-types tests/donePickReader.test.mjs",
    "test:pick-slip": "node --experimental-strip-types tests/pickSlipReader.test.mjs",
    "test:migration": "node --experimental-strip-types tests/migrationPreview.test.mjs",
    "test:business": "node --experimental-strip-types tests/businessRules.test.mjs",
    "test:lr": "node --experimental-strip-types tests/lrReader.test.mjs",
    "test:excel": "node --experimental-strip-types tests/excelReport.test.mjs",
    "test:document-fields": "node --experimental-strip-types tests/documentFields.test.mjs",
    "test:done-pick-albums": "node --experimental-strip-types tests/donePickAlbumRules.test.mjs",
    "test:document-merge": "node --experimental-strip-types tests/documentMerge.test.mjs",
    "test:agent": "node --experimental-strip-types tests/agentCommands.test.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@supabase/supabase-js": "^2.57.0",
    "tesseract.js": "^5.1.1",
    "exceljs": "^4.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
